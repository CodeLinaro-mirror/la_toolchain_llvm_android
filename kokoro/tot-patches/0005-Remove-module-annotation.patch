From: Sharjeel Khan <sharjeelkhan@google.com>
Date: Wed, 25 Feb 2026 22:49:42 +0000
Subject: [PATCH] Revised version of Remove module annotation

Change-Id: Ic2130690a544033880c0d52d35c40a27b358b9d0
---
 stats/atom_field_options.proto        | 2 +-
 stats/stats_log_api_gen/Collation.cpp | 7 -------
 2 files changed, 1 insertion(+), 8 deletions(-)

diff --git a/frameworks/proto_logging/stats/atom_field_options.proto b/frameworks/proto_logging/stats/atom_field_options.proto
index 4e5233649..2b64dfc60 100644
--- a/frameworks/proto_logging/stats/atom_field_options.proto
+++ b/frameworks/proto_logging/stats/atom_field_options.proto
@@ -193,7 +193,7 @@ extend google.protobuf.FieldOptions {
 
     optional LogMode log_mode = 50002 [default = MODE_AUTOMATIC];
 
-    repeated string module = 50004 [deprecated = true];
+    // reserved 50004; module has been moved to module_name
 
     optional bool truncate_timestamp = 50005 [default = false];
 
diff --git a/frameworks/proto_logging/stats/stats_log_api_gen/Collation.cpp b/frameworks/proto_logging/stats/stats_log_api_gen/Collation.cpp
index 3156fd24b..73c2f092e 100644
--- a/frameworks/proto_logging/stats/stats_log_api_gen/Collation.cpp
+++ b/frameworks/proto_logging/stats/stats_log_api_gen/Collation.cpp
@@ -623,13 +623,6 @@ static bool is_atom_in_module(const FieldDescriptor& atomField, const string& mo
         }
     }
 
-    const int moduleCount = atomField.options().ExtensionSize(os::statsd::module);
-    for (int j = 0; j < moduleCount; ++j) {
-        if (atomField.options().GetExtension(os::statsd::module, j) == moduleName) {
-            return true;
-        }
-    }
-
     return false;
 }
 
