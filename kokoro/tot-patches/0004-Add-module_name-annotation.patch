diff --git a/frameworks/proto_logging/stats/atom_field_options.proto b/frameworks/proto_logging/stats/atom_field_options.proto
index 776f3e4f3..4e5233649 100644
--- a/frameworks/proto_logging/stats/atom_field_options.proto
+++ b/frameworks/proto_logging/stats/atom_field_options.proto
@@ -151,6 +151,39 @@ message HistogramBinOption {
     }
 }
 
+// Measurement units usable by performance monitoring tools.
+// Atom fields annotated with the unit will have proper axis labels (and for
+// some units auto-scaled values) when visualized.
+enum Unit {
+  UNIT_UNKNOWN = 0;
+
+  // --------- Time ---------
+  UNIT_NANOSECONDS = 1;
+  UNIT_MICROSECONDS = 2;
+  UNIT_MILLISECONDS = 3;
+  UNIT_SECONDS = 4;
+  UNIT_MINUTES = 5;
+  UNIT_HOURS = 6;
+
+  // --------- Data ---------
+  UNIT_BYTES = 100;
+  UNIT_KILOBYTES = 101;
+  UNIT_MEGABYTES = 102;
+  UNIT_GIGABYTES = 103;
+
+  // --------- Power ---------
+  UNIT_MILLI_AMPS = 200;
+  UNIT_MILL_AMP_HOURS = 201;
+
+  UNIT_MILLI_WATTS = 210;
+  UNIT_MILLI_WATT_HOURS = 211;
+
+  // --------- Other ---------
+  UNIT_COUNT = 10000;
+  // This should be used for data in the range [0..1] meaning 0.1 = 10%.
+  UNIT_PERCENTAGE = 10001;
+}
+
 extend google.protobuf.FieldOptions {
     // Flags to decorate an atom that presents a state change.
     optional StateAtomFieldOption state_field_option = 50000;
@@ -160,7 +193,7 @@ extend google.protobuf.FieldOptions {
 
     optional LogMode log_mode = 50002 [default = MODE_AUTOMATIC];
 
-    repeated string module = 50004;
+    repeated string module = 50004 [deprecated = true];
 
     optional bool truncate_timestamp = 50005 [default = false];
 
@@ -169,4 +202,11 @@ extend google.protobuf.FieldOptions {
     optional FieldRestrictionOption field_restriction_option = 50007;
 
     optional HistogramBinOption histogram_bin_option = 50008;
+
+    // Measurement units usable by performance monitoring tools.
+    // Atom fields with the unit annotated will have proper axis labels (and for
+    // some units auto-scaled values) when visualized.
+    optional Unit unit = 50009;
+
+    repeated string module_name = 50010;
 }
diff --git a/frameworks/proto_logging/stats/stats_log_api_gen/Collation.cpp b/frameworks/proto_logging/stats/stats_log_api_gen/Collation.cpp
index cab8238d4..3156fd24b 100644
--- a/frameworks/proto_logging/stats/stats_log_api_gen/Collation.cpp
+++ b/frameworks/proto_logging/stats/stats_log_api_gen/Collation.cpp
@@ -611,29 +611,38 @@ static AtomType getAtomType(const FieldDescriptor& atomField) {
     }
 }
 
+static bool is_atom_in_module(const FieldDescriptor& atomField, const string& moduleName) {
+    if (moduleName == DEFAULT_MODULE_NAME) {
+        return true;
+    }
+
+    const int moduleNameCount = atomField.options().ExtensionSize(os::statsd::module_name);
+    for (int j = 0; j < moduleNameCount; ++j) {
+        if (atomField.options().GetExtension(os::statsd::module_name, j) == moduleName) {
+            return true;
+        }
+    }
+
+    const int moduleCount = atomField.options().ExtensionSize(os::statsd::module);
+    for (int j = 0; j < moduleCount; ++j) {
+        if (atomField.options().GetExtension(os::statsd::module, j) == moduleName) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
 static int collate_from_field_descriptor(const FieldDescriptor& atomField, const string& moduleName,
                                          Atoms& atoms) {
     int errorCount = 0;
 
-    if (moduleName != DEFAULT_MODULE_NAME) {
-        const int moduleCount = atomField.options().ExtensionSize(os::statsd::module);
-        bool moduleFound = false;
-        for (int j = 0; j < moduleCount; ++j) {
-            const string atomModuleName = atomField.options().GetExtension(os::statsd::module, j);
-            if (atomModuleName == moduleName) {
-                moduleFound = true;
-                break;
-            }
-        }
-
-        // This atom is not in the module we're interested in; skip it.
-        if (!moduleFound) {
-            if (dbg) {
-                printf("   Skipping %s (%d)\n", std::string(atomField.name()).c_str(),
-                       atomField.number());
-            }
-            return errorCount;
+    if (!is_atom_in_module(atomField, moduleName)) {
+        if (dbg) {
+            printf("   Skipping %s (%d)\n", std::string(atomField.name()).c_str(),
+                   atomField.number());
         }
+        return errorCount;
     }
 
     if (dbg) {
diff --git a/frameworks/proto_logging/stats/stats_log_api_gen/test.proto b/frameworks/proto_logging/stats/stats_log_api_gen/test.proto
index 889a906c6..cab14614f 100644
