 libcxx/src/filesystem/format_string.h         | 13 ++--
 .../benchmarks/containers/string.bench.cpp    | 18 +----
 .../resize_default_initialized.pass.cpp       | 75 +++++++++++++++++++
 .../last_write_time.pass.cpp                  |  1 +
 .../filesystems/convert_file_time.pass.cpp    |  1 +
 .../resize_default_initialized.pass.cpp       | 75 +++++++++++++++++++
 7 files changed, 192 insertions(+), 31 deletions(-)
 create mode 100644 libcxx/test/libcxx-03/strings/basic.string/string.modifiers/resize_default_initialized.pass.cpp
