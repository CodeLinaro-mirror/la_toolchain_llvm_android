From a6bb1f131eee0c609632688453ba7986cc952407 Mon Sep 17 00:00:00 2001
From: Nick Desaulniers <ndesaulniers@google.com>
Date: Mon, 12 Oct 2026 14:46:09 -0700
Subject: [PATCH] [Support] Work around glibc pthread_cond_signal bug

Android's build system is seeing occasional deadlocks from LLD blocked
inside `__pthread_cond_wait_common` stemming from a semi-well known bug
in glibc that was fixed in glibc 2.38.

Call `notify_all` in `~TaskGroup` before blocking in `Latch::sync` to
work around lost wakeups from older glibc's `pthread_cond_signal`
stealing. This results in spurious wakes, but workers quickly find
their queues empty and resume sleep. Limit this workaround to just
glibc versions < 2.38.

While users are encouraged to upgrade their systems, doing so from
currently supported LTS distros may be a tall order. Affected distros
and their versions of glibc:
- Ubuntu 22.04 (2.35)
- Debian 12 (2.36)
- RHEL 9 (2.34)

This commit should be reverted once those systems reach EOL.

Link: https://github.com/llvm/llvm-project/pull/231314
---
 llvm/lib/Support/Parallel.cpp | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/llvm/lib/Support/Parallel.cpp b/llvm/lib/Support/Parallel.cpp
index 4554eb7591e1..ee34aa545d17 100644
--- a/llvm/lib/Support/Parallel.cpp
+++ b/llvm/lib/Support/Parallel.cpp
@@ -127,6 +127,12 @@ class ThreadPoolExecutor {
 
   size_t getThreadCount() const { return ThreadCount; }
 
+  void notifyAll() {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    if (!WorkStack.empty())
+      Cond.notify_all();
+  }
+
 private:
   // Pop one task from the queue and run it. Must be called with Lock held;
   // releases Lock before executing the task.
@@ -248,8 +254,20 @@ TaskGroup::TaskGroup()
 TaskGroup::~TaskGroup() {
 #if LLVM_ENABLE_THREADS
   // In a nested TaskGroup (threadIndex != -1u), actively help drain the queue.
-  if (Parallel && isNested())
-    getDefaultExecutor()->helpSync(L);
+  if (Parallel) {
+    if (isNested())
+      getDefaultExecutor()->helpSync(L);
+#if defined(__linux__) && defined(__GLIBC__) && __GLIBC__ == 2 &&              \
+    __GLIBC_MINOR__ < 38
+    // Workaround for https://sourceware.org/bugzilla/show_bug.cgi?id=25847
+    // Fixed in glibc 2.38, but LTS distros such as Ubuntu 22.04 (2.35),
+    // Debian 12 (2.36), and RHEL 9 (2.34) distribute older versions of glibc
+    // where notify_one() (pthread_cond_signal) can drop wakeups under
+    // contention. Broadcast wakes all workers so tasks aren't stranded.
+    else
+      getDefaultExecutor()->notifyAll();
+#endif
+  }
 #endif
   L.sync();
 }
-- 
