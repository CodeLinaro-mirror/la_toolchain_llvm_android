--- a/compiler-rt/lib/asan/asan_new_delete.cpp
+++ b/compiler-rt/lib/asan/asan_new_delete.cpp
@@ -18,7 +18,6 @@
 #include "asan_report.h"
 #include "asan_stack.h"
