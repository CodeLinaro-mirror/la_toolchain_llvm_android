-  // CHECK-NEXT: br label
-  //   -> rethrow
+  // CHECK-NEXT: br i1
+  //   -> ret, rethrow
 
-  // finally.end.critedge:  Predecessors are the @try and @catch fallthroughs.
-  // CHECK:      call void @objc_exception_try_exit(ptr nonnull [[EXNDATA]])
-  // CHECK-NEXT: call void @f4_help(i32 noundef 2)
-  // CHECK-NEXT: ret void
+  // ret:
+  // CHECK:      ret void
 
