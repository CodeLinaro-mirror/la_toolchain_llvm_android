 llvm/include/llvm/MC/MCInstrDesc.h            |  5 ++
 llvm/include/llvm/MC/MCLFIRewriter.h          |  2 +
 llvm/lib/MC/MCInstrDesc.cpp                   | 12 +++-
 llvm/lib/MC/MCLFIRewriter.cpp                 |  6 ++
 llvm/lib/Target/AArch64/AArch64InstrInfo.cpp  | 25 ++++++--
 .../MCTargetDesc/AArch64MCLFIRewriter.cpp     | 57 +++++++++++++++++++
 .../MCTargetDesc/AArch64MCLFIRewriter.h       | 10 ++++
 llvm/test/MC/AArch64/LFI/branch.s             | 21 +++++++
 llvm/test/MC/AArch64/LFI/return.s             | 25 ++++++++
 10 files changed, 156 insertions(+), 11 deletions(-)
