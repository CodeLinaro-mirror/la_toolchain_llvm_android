 .../Process/Linux/NativeThreadLinux.cpp        |  6 +++++-
 .../Plugins/Process/Linux/SingleStepCheck.cpp  |  5 ++++-
 10 files changed, 31 insertions(+), 31 deletions(-)
 delete mode 100644 lldb/include/lldb/Host/linux/Ptrace.h

