-        }
-      }
     }
 
     // If C1 masks off the upper bits only (but can't be formed as an
@@ -3053,33 +3032,6 @@ bool RISCVDAGToDAGISel::selectSHXADDOp(SDValue N, unsigned ShAmt,
           return true;
         }
       }
-    } else if (N0.getOpcode() == ISD::SRA && N0.hasOneUse() &&
