+static bool isWriteSegmentBase(unsigned Opcode) {
+  switch (Opcode) {
+  case X86::WRFSBASE:
+  case X86::WRFSBASE64:
+  case X86::WRGSBASE:
+  case X86::WRGSBASE64:
