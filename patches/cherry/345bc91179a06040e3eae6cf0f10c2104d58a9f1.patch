@@ -311,13 +370,14 @@ void X86::X86MCLFIRewriter::rewriteFSAccess(const MCInst &Inst, MCStreamer &Out,
   bool HasDisp = !Inst.getOperand(MemIdx + X86::AddrDisp).isImm() ||
