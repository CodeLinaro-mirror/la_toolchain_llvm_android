+
+// Return true if Reg always contains an address within the sandbox.
+static bool isSandboxBaseReg(MCRegister Reg) {
+  return Reg == LFIBaseReg || Reg == X86::RSP || Reg == X86::RIP;
+}
+
+// Return true if Inst reads or writes memory through a pointer register
+// instead of an addressing mode, and so cannot be sandboxed by rewriting its
+// operands.
+static bool hasImplicitMemPointer(unsigned Opcode) {
+  switch (Opcode) {
+  // xlat loads from (%rbx,%al).
+  case X86::XLAT:
+  // maskmov stores to (%rdi).
+  case X86::MASKMOVDQU:
+  case X86::MASKMOVDQU64:
+  case X86::VMASKMOVDQU:
+  case X86::VMASKMOVDQU64:
+  case X86::MMX_MASKMOVQ:
+  case X86::MMX_MASKMOVQ64:
+  // clzero zeroes the cache line at (%rax).
+  case X86::CLZERO32r:
+  case X86::CLZERO64r:
+  // movdir64b and enqcmd store to the address in their register operand.
+  case X86::MOVDIR64B32:
+  case X86::MOVDIR64B64:
+  case X86::MOVDIR64B32_EVEX:
+  case X86::MOVDIR64B64_EVEX:
+  case X86::ENQCMD32:
+  case X86::ENQCMD64:
+  case X86::ENQCMD32_EVEX:
+  case X86::ENQCMD64_EVEX:
+  case X86::ENQCMDS32:
+  case X86::ENQCMDS64:
+  case X86::ENQCMDS32_EVEX:
+  case X86::ENQCMDS64_EVEX:
+    return true;
+  default:
+    return false;
+  }
+}
+
+// Return true if Inst is a bit test of memory with a register bit offset. The
+// offset is added to the address of the memory operand, so the bit it accesses
+// may be beyond the address computed by the addressing mode.
+static bool isBitTestWithRegOffset(unsigned Opcode) {
+  switch (Opcode) {
+  case X86::BT16mr:
+  case X86::BT32mr:
+  case X86::BT64mr:
+  case X86::BTC16mr:
+  case X86::BTC32mr:
+  case X86::BTC64mr:
+  case X86::BTR16mr:
+  case X86::BTR32mr:
+  case X86::BTR64mr:
+  case X86::BTS16mr:
+  case X86::BTS32mr:
+  case X86::BTS64mr:
+  case X86::LOCK_BTC_RM16rm:
+  case X86::LOCK_BTC_RM32rm:
+  case X86::LOCK_BTC_RM64rm:
+  case X86::LOCK_BTR_RM16rm:
+  case X86::LOCK_BTR_RM32rm:
+  case X86::LOCK_BTR_RM64rm:
+  case X86::LOCK_BTS_RM16rm:
+  case X86::LOCK_BTS_RM32rm:
+  case X86::LOCK_BTS_RM64rm:
+    return true;
+  default:
+    return false;
+  }
+}
+
+// Return true if Inst has a memory operand that is not dereferenced.
+static bool ignoresMemOperand(unsigned Opcode) {
+  switch (Opcode) {
+  case X86::LEA16r:
+  case X86::LEA32r:
+  case X86::LEA64r:
+  case X86::LEA64_32r:
+  case X86::NOOPW:
+  case X86::NOOPL:
+  case X86::NOOPQ:
+    return true;
+  default:
+    return false;
+  }
+}
+
+// Return true if the index register of the memory operand at MemIdx is a
+// general-purpose register, and so can be truncated along with the base.
+static bool hasGPRIndex(const MCInst &Inst, int MemIdx) {
+  MCRegister Index = Inst.getOperand(MemIdx + X86::AddrIndexReg).getReg();
+  return Index && getX86MCRegisterClass(X86::GR64RegClassID).contains(Index);
+}
+
+// Return true if the memory operand at MemIdx uses a 32-bit address size,
+// which is selected by a 32-bit base or index register.
+static bool has32BitAddress(const MCInst &Inst, int MemIdx) {
+  MCRegister Base = Inst.getOperand(MemIdx + X86::AddrBaseReg).getReg();
+  MCRegister Index = Inst.getOperand(MemIdx + X86::AddrIndexReg).getReg();
+  const MCRegisterClass &GR32 = getX86MCRegisterClass(X86::GR32RegClassID);
+  return Base == X86::EIP || GR32.contains(Base) || Index == X86::EIZ ||
+         GR32.contains(Index);
+}
+
+// Rewrite the addressing mode of the memory operand at MemIdx so that the
+// access it performs stays inside the sandbox.
+//
+// movq 8(%rax,%rcx,4), %rdi
+// ->
+// movq %gs:8(%eax,%ecx,4), %rdi
+void X86::X86MCLFIRewriter::sandboxMemOperand(MCInst &Inst, int MemIdx) const {
+  MCOperand &Base = Inst.getOperand(MemIdx + X86::AddrBaseReg);
+  MCOperand &Scale = Inst.getOperand(MemIdx + X86::AddrScaleAmt);
+  MCOperand &Index = Inst.getOperand(MemIdx + X86::AddrIndexReg);
+  MCOperand &Segment = Inst.getOperand(MemIdx + X86::AddrSegmentReg);
+
+  // %riz only encodes the absence of an index register, so drop it and handle
+  // the access as one without an index.
+  if (Index.getReg() == X86::RIZ) {
+    Index.setReg(X86::NoRegister);
+    Scale.setImm(1);
+  }
+
+  // A base register that always points into the sandbox needs no rewriting, as
+  // long as there is no index register.
+  if (isSandboxBaseReg(Base.getReg()) && !Index.getReg())
+    return;
+
+  // An absolute address has no register to truncate, so make it relative to
+  // the sandbox base instead.
+  if (!Base.getReg() && !Index.getReg()) {
+    Base.setReg(LFIBaseReg);
+    return;
+  }
+
+  // If there is no Base and the Index is not a GPR, then we use r14d (all
+  // zeroes) as the base for the rewritten addressing mode.
+  bool GPRIndex = hasGPRIndex(Inst, MemIdx);
+
+  Segment.setReg(LFIBaseSeg);
+  if (Base.getReg())
+    Base.setReg(getReg32(Base.getReg()));
+  else if (!GPRIndex)
+    Base.setReg(getReg32(LFIBaseReg));
+  if (GPRIndex)
+    Index.setReg(getReg32(Index.getReg()));
+}
+
+void X86::X86MCLFIRewriter::sandboxMemAccess(MCInst &Inst) const {
+  if (ignoresMemOperand(Inst.getOpcode()))
+    return;
+
+  int MemIdx = X86II::getMemoryOperandIdx(InstInfo->get(Inst.getOpcode()));
+  if (MemIdx >= 0)
+    sandboxMemOperand(Inst, MemIdx);
+}
+
+void X86::X86MCLFIRewriter::rewriteMemAccess(const MCInst &Inst,
+                                             MCStreamer &Out,
+                                             const MCSubtargetInfo &STI) {
+  MCInst Sandboxed(Inst);
+  sandboxMemAccess(Sandboxed);
+  emitWithPrefixes(Sandboxed, Out, STI);
+}
+
+namespace {
+struct StringOpPointers {
+  bool UsesDest;
+  bool UsesSrc;
+};
+} // namespace
+
+static std::optional<StringOpPointers> getStringOpPointers(unsigned Opcode) {
+  switch (Opcode) {
+  case X86::STOSB:
+  case X86::STOSW:
+  case X86::STOSL:
+  case X86::STOSQ:
+  case X86::REP_STOSB_64:
+  case X86::REP_STOSW_64:
+  case X86::REP_STOSD_64:
+  case X86::REP_STOSQ_64:
+  case X86::SCASB:
+  case X86::SCASW:
+  case X86::SCASL:
+  case X86::SCASQ:
+    return StringOpPointers{true, false};
+  case X86::MOVSB:
+  case X86::MOVSW:
+  case X86::MOVSL:
+  case X86::MOVSQ:
+  case X86::REP_MOVSB_64:
+  case X86::REP_MOVSW_64:
+  case X86::REP_MOVSD_64:
+  case X86::REP_MOVSQ_64:
+  case X86::CMPSB:
+  case X86::CMPSW:
+  case X86::CMPSL:
+  case X86::CMPSQ:
+    return StringOpPointers{true, true};
+  case X86::LODSB:
+  case X86::LODSW:
+  case X86::LODSL:
+  case X86::LODSQ:
+    return StringOpPointers{false, true};
+  default:
+    return std::nullopt;
+  }
+}
+
+static void emitStringPtrFixup(MCRegister Reg, MCRegister Reg32,
+                               MCStreamer &Out, const MCSubtargetInfo &STI) {
+  Out.emitInstruction(MCInstBuilder(X86::MOV32rr).addReg(Reg32).addReg(Reg32),
+                      STI);
+
+  Out.emitInstruction(MCInstBuilder(X86::LEA64r)
+                          .addReg(Reg)
+                          .addReg(LFIBaseReg)
+                          .addImm(1)
+                          .addReg(Reg)
+                          .addImm(0)
+                          .addReg(X86::NoRegister),
+                      STI);
+}
+
+// rep movsq
+// ->
+// .bundle_lock
+// movl %edi, %edi
+// leaq (%r14,%rdi), %rdi
+// movl %esi, %esi
+// leaq (%r14,%rsi), %rsi
+// rep movsq
+// .bundle_unlock
+void X86::X86MCLFIRewriter::rewriteStringOperation(const MCInst &Inst,
+                                                   MCStreamer &Out,
+                                                   const MCSubtargetInfo &STI) {
+  std::optional<StringOpPointers> Ptrs = getStringOpPointers(Inst.getOpcode());
+  assert(Ptrs && "expected a string instruction");
+
+  // The guards below sandbox the full 64-bit %rdi and %rsi, so the access must
+  // use them with a 64-bit address size and no %fs segment override.
+  for (const MCOperand &Op : Inst) {
+    if (!Op.isReg())
+      continue;
+    if (Op.getReg() == X86::EDI || Op.getReg() == X86::ESI)
+      return error(Inst, "unsupported address size for string instruction");
+    if (Op.getReg() == X86::FS)
+      return error(Inst, "unsupported segment override for string instruction");
+  }
+
+  Out.emitBundleLock(/*AlignToEnd=*/false, STI);
+
+  if (Ptrs->UsesDest)
+    emitStringPtrFixup(X86::RDI, X86::EDI, Out, STI);
+  if (Ptrs->UsesSrc)
+    emitStringPtrFixup(X86::RSI, X86::ESI, Out, STI);
+
+  emitWithPrefixes(Inst, Out, STI);
+
+  Out.emitBundleUnlock(STI);
+}
+
+// The register form of an instruction that modifies the stack and reads its
+// source from memory, if there is one.
+static std::optional<unsigned> memToRegOpcode(unsigned Opcode) {
+  switch (Opcode) {
+  case X86::MOV64rm:
+    return X86::MOV64rr;
+  case X86::ADD64rm:
+    return X86::ADD64rr;
+  case X86::SUB64rm:
+    return X86::SUB64rr;
+  case X86::AND64rm:
+    return X86::AND64rr;
+  case X86::OR64rm:
+    return X86::OR64rr;
+  case X86::XOR64rm:
+    return X86::XOR64rr;
+  default:
+    return std::nullopt;
+  }
+}
+
+// The 32-bit form of a 64-bit instruction, if it has one that can be used to
+// modify the stack pointer.
+static std::optional<unsigned> demote64BitOpcode(unsigned Opcode) {
+  switch (Opcode) {
+  case X86::MOV64rr:
+    return X86::MOV32rr;
+  case X86::MOV64ri32:
+    return X86::MOV32ri;
+  case X86::LEA64r:
+    return X86::LEA64_32r;
+  case X86::ADD64rr:
+    return X86::ADD32rr;
+  case X86::ADD64ri8:
+    return X86::ADD32ri8;
+  case X86::ADD64ri32:
+    return X86::ADD32ri;
+  case X86::SUB64rr:
+    return X86::SUB32rr;
+  case X86::SUB64ri8:
+    return X86::SUB32ri8;
+  case X86::SUB64ri32:
+    return X86::SUB32ri;
+  case X86::AND64rr:
+    return X86::AND32rr;
+  case X86::AND64ri8:
+    return X86::AND32ri8;
+  case X86::AND64ri32:
+    return X86::AND32ri;
+  case X86::OR64rr:
+    return X86::OR32rr;
+  case X86::OR64ri8:
+    return X86::OR32ri8;
+  case X86::OR64ri32:
+    return X86::OR32ri;
+  case X86::XOR64rr:
+    return X86::XOR32rr;
+  case X86::XOR64ri8:
+    return X86::XOR32ri8;
+  case X86::XOR64ri32:
+    return X86::XOR32ri;
+  default:
+    return std::nullopt;
+  }
+}
+
+MCRegister X86::X86MCLFIRewriter::getWrittenStackReg(const MCInst &Inst) const {
+  const MCInstrDesc &Desc = InstInfo->get(Inst.getOpcode());
+  for (unsigned I = 0, E = Desc.getNumDefs(); I < E; ++I) {
+    const MCOperand &Op = Inst.getOperand(I);
+    if (Op.isReg() && RegInfo->regsOverlap(Op.getReg(), X86::RSP))
+      return Op.getReg();
+  }
+  return X86::NoRegister;
+}
+
+// Emit leaq (%rsp,%r14), %rsp
+static void emitStackFixup(MCStreamer &Out, const MCSubtargetInfo &STI) {
+  Out.emitInstruction(MCInstBuilder(X86::LEA64r)
+                          .addReg(X86::RSP)
+                          .addReg(X86::RSP)
+                          .addImm(1)
+                          .addReg(LFIBaseReg)
+                          .addImm(0)
+                          .addReg(X86::NoRegister),
+                      STI);
+}
+
+// addq $8, %rsp
+// ->
+// .bundle_lock
+// addl $8, %esp
+// leaq (%rsp,%r14), %rsp
+// .bundle_unlock
+void X86::X86MCLFIRewriter::rewriteStackModification(
+    MCRegister StackReg, const MCInst &Inst, MCStreamer &Out,
+    const MCSubtargetInfo &STI) {
+  if (StackReg != X86::RSP)
+    return error(Inst, "unsupported modification of the stack pointer");
+
+  discardPrefixes();
+
+  // popq %rsp loads through the stack pointer that it overwrites, so it cannot
+  // simply be demoted. Pop into the scratch register instead, and move the
+  // result into %esp.
+  if (Inst.getOpcode() == X86::POP64r) {
+    Out.emitInstruction(MCInstBuilder(X86::POP64r).addReg(LFIScratchReg), STI);
+
+    Out.emitBundleLock(/*AlignToEnd=*/false, STI);
+    Out.emitInstruction(
+        MCInstBuilder(X86::MOV32rr).addReg(X86::ESP).addReg(X86::R11D), STI);
+    emitStackFixup(Out, STI);
+    Out.emitBundleUnlock(STI);
+    return;
+  }
+
+  // movq 8(%rdi), %rsp
+  // ->
+  // movq %gs:8(%edi), %r11
+  // .bundle_lock
+  // movl %r11d, %esp
+  // leaq (%rsp,%r14), %rsp
+  // .bundle_unlock
+  int MemIdx = X86II::getMemoryOperandIdx(InstInfo->get(Inst.getOpcode()));
+  if (MemIdx >= 0 && !ignoresMemOperand(Inst.getOpcode())) {
+    std::optional<unsigned> RegOpcode = memToRegOpcode(Inst.getOpcode());
+    if (!RegOpcode)
+      return error(Inst, "unsupported modification of the stack pointer");
+
+    MCInstBuilder Load(X86::MOV64rm);
+    Load.addReg(LFIScratchReg);
+    for (unsigned I = 0; I < X86::AddrNumOperands; ++I)
+      Load.addOperand(Inst.getOperand(MemIdx + I));
+    Load.setLoc(Inst.getLoc());
+    doRewriteInst(Load, Out, STI);
+
+    MCInstBuilder RegForm(*RegOpcode);
+    for (int I = 0; I < MemIdx; ++I)
+      RegForm.addOperand(Inst.getOperand(I));
+    RegForm.addReg(LFIScratchReg);
+    RegForm.setLoc(Inst.getLoc());
+    return doRewriteInst(RegForm, Out, STI);
+  }
+
+  std::optional<unsigned> Opcode = demote64BitOpcode(Inst.getOpcode());
+  if (!Opcode)
+    return error(Inst, "unsupported modification of the stack pointer");
+
+  MCInst Modified(Inst);
+  Modified.setOpcode(*Opcode);
+
+  ArrayRef<MCOperandInfo> OpInfo = InstInfo->get(*Opcode).operands();
+  for (unsigned I = 0, E = std::min<unsigned>(OpInfo.size(),
+                                              Modified.getNumOperands());
+       I < E; ++I) {
+    MCOperand &Op = Modified.getOperand(I);
+    if (OpInfo[I].OperandType != MCOI::OPERAND_REGISTER || !Op.isReg())
+      continue;
+    if (getX86MCRegisterClass(X86::GR64RegClassID).contains(Op.getReg()))
+      Op.setReg(RegInfo->getSubReg(Op.getReg(), X86::sub_32bit));
+  }
+
+  Out.emitBundleLock(/*AlignToEnd=*/false, STI);
   Out.emitInstruction(Modified, STI);
+  emitStackFixup(Out, STI);
+  Out.emitBundleUnlock(STI);
+}
+
+// leave
+// ->
+// .bundle_lock
+// movl %ebp, %esp
+// leaq (%rsp,%r14), %rsp
+// .bundle_unlock
+// popq %rbp
+void X86::X86MCLFIRewriter::rewriteLeave(const MCInst &Inst, MCStreamer &Out,
+                                         const MCSubtargetInfo &STI) {
+  doRewriteInst(MCInstBuilder(X86::MOV64rr)
+                    .addReg(X86::RSP)
+                    .addReg(X86::RBP)
+                    .setLoc(Inst.getLoc()),
+                Out, STI);
+  Out.emitInstruction(MCInstBuilder(X86::POP64r).addReg(X86::RBP), STI);
 }
 
